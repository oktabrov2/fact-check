# Copy values into environment.env. Never commit that file.
# OPENAI_API_KEY=your_openai_api_key
# api_key=your_openai_api_key
# PostgreSQL connection string for trusted sources, accounts, and sessions.
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/fact_check
# Set to true for managed PostgreSQL providers that require TLS.
# DATABASE_SSL=false
# TLS certificates are verified by default. Set false only when your provider explicitly requires it.
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Required for the separate administrator area. The password is stored only as a salted hash in PostgreSQL.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-long-unique-password
# Set true for one start only when deliberately rotating the administrator password.
# ADMIN_PASSWORD_ROTATE=false
# Optional public donation destination. Use an HTTPS payment link; no payment secret belongs in this file.
# DONATION_PROVIDER=Stripe
# DONATION_URL=https://donate.stripe.com/your-payment-link
# Optional: defaults to gpt-5.
# OPENAI_MODEL=gpt-5
# PORT=3000
